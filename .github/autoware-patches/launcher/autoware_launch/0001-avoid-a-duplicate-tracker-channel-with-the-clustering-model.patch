From 8f7c6e01a2ce4afc0b7b5d95d98417b075933bbd Mon Sep 17 00:00:00 2001
From: oguzkaganozt <oguzkaganozt@gmail.com>
Date: Mon, 26 Oct 2026 03:14:25 +0300
Subject: [PATCH] fix(autoware_perception_launch): avoid a duplicate tracker channel with the clustering model (#2008)

Upstream: https://github.com/autowarefoundation/autoware_launch/pull/2008

Signed-off-by: Oguz Ozturk <oguzkaganozt@gmail.com>
---
 .../object_recognition/object_recognition_lidar.launch.xml    | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/autoware_universe_launch/autoware_perception_launch/launch/object_recognition/object_recognition_lidar.launch.xml b/autoware_universe_launch/autoware_perception_launch/launch/object_recognition/object_recognition_lidar.launch.xml
index fa7561b269..f4a5864359 100644
--- a/autoware_universe_launch/autoware_perception_launch/launch/object_recognition/object_recognition_lidar.launch.xml
+++ b/autoware_universe_launch/autoware_perception_launch/launch/object_recognition/object_recognition_lidar.launch.xml
@@ -151,7 +151,9 @@
   <group>
     <push-ros-namespace namespace="tracking"/>
 
-    <let name="input/detection01/channel" value="lidar_$(var lidar_detection_model_type)"/>
+    <!-- With the clustering model, the ML channel would duplicate detection03's lidar_clustering channel -->
+    <let name="input/detection01/channel" value="lidar_$(var lidar_detection_model_type)" unless="$(eval &quot;'$(var lidar_detection_model_type)' == 'clustering'&quot;)"/>
+    <let name="input/detection01/channel" value="none" if="$(eval &quot;'$(var lidar_detection_model_type)' == 'clustering'&quot;)"/>
     <let name="input/detection01/objects" value="$(var lidar_object_filter/output/objects)" if="$(var use_validator)"/>
     <let name="input/detection01/objects" value="$(var lidar_ml_detector/output/objects)" unless="$(var use_validator)"/>
 
