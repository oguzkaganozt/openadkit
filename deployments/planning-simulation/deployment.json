{
  "schemaVersion": 2,
  "description": "Autoware planning and control in the built-in simulator",
  "shared": ["shared"],
  "compose": {
    "files": ["compose.yaml"],
    "gpuFiles": ["compose.gpu.yaml"],
    "oneShotServices": ["map-check"],
    "waitTimeout": 600
  },
  "verify": {
    "service": "api",
    "command": ["python3", "/openadkit/checks/drive_to_goal.py"]
  },
  "requirements": {
    "architectures": ["amd64", "arm64"],
    "rosDistros": ["humble", "jazzy"],
    "gpu": "optional",
    "gpuArchitectures": ["amd64"]
  },
  "data": [
    {
      "name": "sample-map-planning",
      "kind": "zip",
      "destinationEnv": "MAP_PATH",
      "expectedRoot": "sample-map-planning",
      "url": "https://autoware-files.s3.us-west-2.amazonaws.com/maps/demos/sample-map-planning.zip",
      "sha256": "5536fce7bb8db7688fdf94ec004118b898637ad0d5b6175108b10989dd6e93b9",
      "requiredFiles": ["lanelet2_map.osm", "pointcloud_map.pcd"]
    },
    {
      "name": "diffusion-planner-model",
      "kind": "files",
      "destinationEnv": "DIFFUSION_PLANNER_DATA_PATH",
      "gpu": true,
      "files": [
        {
          "path": "diffusion_planner_encoder.onnx",
          "url": "https://huggingface.co/AutowareFoundation/diffusion_planner/resolve/bfd50193841f20b2131fd546feaf2f8456f0133e/diffusion_planner_encoder.onnx",
          "sha256": "2856886a3ed63b963cb18b457876d0bbd8916d345549ee5f199ceb49e3fcca49"
        },
        {
          "path": "diffusion_planner_decoder.onnx",
          "url": "https://huggingface.co/AutowareFoundation/diffusion_planner/resolve/bfd50193841f20b2131fd546feaf2f8456f0133e/diffusion_planner_decoder.onnx",
          "sha256": "eb30c0c0c8e80b8460d293d600c7b8c9e21f615ff6ce8de5ed01670c3d1057ca"
        },
        {
          "path": "diffusion_planner_turn_indicator.onnx",
          "url": "https://huggingface.co/AutowareFoundation/diffusion_planner/resolve/bfd50193841f20b2131fd546feaf2f8456f0133e/diffusion_planner_turn_indicator.onnx",
          "sha256": "07acfb58a5de1f25587fa86deb39a6de5605f8d93518e97f960ee27145f4a732"
        },
        {
          "path": "diffusion_planner.param.json",
          "url": "https://huggingface.co/AutowareFoundation/diffusion_planner/resolve/bfd50193841f20b2131fd546feaf2f8456f0133e/diffusion_planner.param.json",
          "sha256": "ee3145b68fd1e1e44e532933dfe66cfee4384fbd637382c87ab5190c66a8e268"
