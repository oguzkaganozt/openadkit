# GPU mode of planning simulation: Autoware 2.0's Diffusion Planner. Loaded
# after settings.env when --gpu is set; the host settings file
# (~/.config/openadkit/<name>.env) still wins.
PLANNING_SETTING=diffusion_planner
# autoware_launch's diagnostics graph for this planner: the rule-based
# planner's trajectory checks have no counterpart in it.
SYSTEM_DIAGNOSTICS_GRAPH=autoware-main-e2e.yaml
