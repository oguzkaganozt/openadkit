# Values (extension point 1): what differs from planning-simulation.
#
# The vehicle and sensor models are the M2's own packages, built into
# overlay_ws and mounted into every Autoware service.
VEHICLE_MODEL=verve_m2_vehicle
SENSOR_MODEL=verve_m2_layout4cam1lidar_sensor_kit

# verve_sim's ros service publishes /clock and the vehicle state.
USE_SIM_TIME=true

# Autoware's own vehicle interface is off: verve_sim's ros service is the
# vehicle interface, and a second one would fight it for the command topics.
LAUNCH_VEHICLE_INTERFACE=false

# Localization: NDT against the Town01 point cloud map, with the IMU and the
# vehicle's own wheels (gyro odometry) as the twist source.
PLANNING_MODULE_PRESET=default
CONTROL_MODULE_PRESET=default
LATERAL_CONTROLLER_MODE=mpc
LONGITUDINAL_CONTROLLER_MODE=pid

# The world is real (CARLA); only the vehicle is simulated.
# system_run_mode=online turns on the pose initializer's stop check, which
# reads the vehicle velocity converter's twist, and online is what the base
# deployment runs. It passes because verve_sim's plant holds the M2 genuinely
# still under the brake (plant/m2.py's park brake). The mode only decides
# that check (autoware_launch component_localization.launch.xml).
IS_SIMULATION_MODE=false
SYSTEM_RUN_MODE=online
ENABLE_ALL_MODULES_AUTO_MODE=true
CHECK_EXTERNAL_EMERGENCY_HEARTBEAT=false
SYSTEM_DIAGNOSTICS_GRAPH=autoware-carla.yaml
LAUNCH_SYSTEM_MONITOR=false
LAUNCH_DUMMY_DIAG_PUBLISHER=false

# Perception: real LiDAR points from CARLA, no traffic light recognition yet.
# The M2 sensor kit loads its crop filters into the sensing pointcloud
# container, so it must be launched here.
LAUNCH_POINTCLOUD_CONTAINER_SENSING=true
LAUNCH_SENSING_DRIVER=true
LAUNCH_POINTCLOUD_CONTAINER_PERCEPTION=false
LIDAR_DETECTION_MODEL=clustering
OCCUPANCY_GRID_MAP_METHOD=pointcloud_based
PERCEPTION_MODE=lidar
USE_EMPTY_DYNAMIC_OBJECT_PUBLISHER=false
USE_TRAFFIC_LIGHT_RECOGNITION=false

# The map is the base's: CARLA Town01's lanelet2 and NDT point cloud.
POINTCLOUD_MAP_FILE=pointcloud_map.pcd
LANELET2_MAP_FILE=lanelet2_map.osm
