<launch>
  <!-- Overlay copy for verve_sim: the IMU and the GNSS come from verve_sim's
       ros service (/sensing/imu/imu_data, /sensing/gnss/pose_with_covariance),
       so there is no serial IMU driver to start and no tamagawa node to
       resolve. The real package's driver include fails here because the
       Open AD Kit images do not ship tamagawa_imu_driver. -->
  <arg name="launch_driver" default="false"/>
  <group>
    <push-ros-namespace namespace="imu"/>
    <include file="$(find-pkg-share autoware_imu_corrector)/launch/gyro_bias_estimator.launch.xml">
      <arg name="input_imu_raw" value="/sensing/imu/imu_data"/>
      <arg name="input_odom" value="/localization/kinematic_state"/>
    </include>
  </group>
</launch>
