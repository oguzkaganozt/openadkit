# ROS settings
ROS_DOMAIN_ID=1
USE_SIM_TIME=true

# CARLA runtime
CARLA_IMAGE=carlasim/carla:0.9.15
CARLA_WORLD=Town01
CARLA_QUALITY=Epic
CARLA_RENDERING=-RenderOffScreen
CARLA_RPC_PORT=2000
CARLA_WORLD_PORT=2000

# CARLA ROS bridge
CARLA_ROS_BRIDGE_IMAGE=local/carla-ros-bridge:0.9.15-humble
CARLA_ROS_BRIDGE_HOST=localhost
CARLA_ROS_BRIDGE_PORT=2000
CARLA_ROS_BRIDGE_LAUNCH_FILE=carla_ros_bridge_with_example_ego_vehicle.launch.py
CARLA_ROS_BRIDGE_LAUNCH_ARGS=timeout:=300
CARLA_EGO_VEHICLE_NAME=ego_vehicle
# Set only for launch files that declare `synchronous_mode`
CARLA_SYNCHRONOUS_MODE=

# OpenADKit simulation settings
SCENARIO_SIMULATION=false
IS_SIMULATION_MODE=true
USE_POINTCLOUD_CONTAINER=false
VEHICLE_ID=default
VEHICLE_MODEL=sample_vehicle
SENSOR_MODEL=sample_sensor_kit

# Map settings
LANELET2_MAP_FILE=lanelet2_map.osm
MAP_PATH=$HOME/autoware_map/sample-map-planning
POINTCLOUD_MAP_FILE=pointcloud_map.pcd

# Planning
POINTCLOUD_CONTAINER_NAME=pointcloud_container
PLANNING_MODULE_PRESET=default
ENABLE_ALL_MODULES_AUTO_MODE=false

# Control
CHECK_EXTERNAL_EMERGENCY_HEARTBEAT=false
CONTROL_MODULE_PRESET=default
LATERAL_CONTROLLER_MODE=mpc
LONGITUDINAL_CONTROLLER_MODE=pid

# Vehicle
LAUNCH_VEHICLE_INTERFACE=true

# System
SYSTEM_RUN_MODE=planning_simulation
LAUNCH_SYSTEM_MONITOR=false
LAUNCH_DUMMY_DIAG_PUBLISHER=true

# Simulator
INITIAL_ENGAGE_STATE=true
LAUNCH_DUMMY_VEHICLE=false
LAUNCH_DUMMY_PERCEPTION=false
LAUNCH_DUMMY_DOORS=false
LAUNCH_SCENARIO_SIMULATOR_V2_ADAPTER=false
LOCALIZATION_SIM_MODE=api
PERCEPTION_ENABLE_DETECTION_FAILURE=true
PERCEPTION_ENABLE_OBJECT_RECOGNITION=true
PERCEPTION_ENABLE_TRAFFIC_LIGHT=false
PERCEPTION_USE_BASE_LINK_Z=true
SENSING_VISIBLE_RANGE=300.0

# Visualization
REMOTE_DISPLAY=true
RVIZ_CONFIG=/opt/autoware/share/autoware_launch/rviz/autoware.rviz
