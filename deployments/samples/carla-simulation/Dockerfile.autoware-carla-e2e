FROM ghcr.io/autowarefoundation/openadkit:sensing-perception-cuda AS sensing_perception_cuda

FROM ghcr.io/autowarefoundation/openadkit:universe

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ros-humble-geographic-msgs \
    ros-humble-lanelet2 \
    ros-humble-logging-demo \
    ros-humble-osqp-vendor \
    ros-humble-pcl-msgs \
    ros-humble-rsl \
    ros-humble-xacro \
  && python3 -m pip install --no-cache-dir carla==0.9.15 \
  && rm -rf /var/lib/apt/lists/*

COPY --from=sensing_perception_cuda /opt/autoware/lib/libpointcloud_based_occupancy_grid_map.so /opt/autoware/lib/
COPY --from=sensing_perception_cuda /opt/autoware/lib/libautoware_probabilistic_occupancy_grid_map_common.so /opt/autoware/lib/
COPY --from=sensing_perception_cuda /opt/autoware/lib/libautoware_probabilistic_occupancy_grid_map_cuda.so /opt/autoware/lib/
COPY --from=sensing_perception_cuda /opt/autoware/lib/libsynchronized_grid_map_fusion.so /opt/autoware/lib/
COPY --from=sensing_perception_cuda /opt/autoware/share/ament_index/resource_index/rclcpp_components/autoware_probabilistic_occupancy_grid_map /opt/autoware/share/ament_index/resource_index/rclcpp_components/

# Native CARLA on a visible X display can crash when the interface reloads the
# same map during startup. Preload Town01 in the launcher, then skip only this
# redundant load_world call while preserving map reloads for other maps.
RUN python3 - <<'PY'
from pathlib import Path

path = Path('/opt/autoware/lib/python3.10/site-packages/autoware_carla_interface/carla_autoware.py')
text = path.read_text()
old = '        client.load_world(self.carla_map)\n        self.world = client.get_world()\n'
new = '''        current_world = client.get_world()
        current_map = current_world.get_map().name
        if not current_map.endswith("/" + self.carla_map):
            client.load_world(self.carla_map)
        self.world = client.get_world()
'''
if old not in text:
    raise SystemExit('autoware_carla_interface load_world block not found')
path.write_text(text.replace(old, new, 1))
PY
